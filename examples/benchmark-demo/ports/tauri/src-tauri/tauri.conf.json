{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NucleusBenchmarkTauri",
  "version": "1.0.0",
  "identifier": "dev.nucleusframework.benchmark.tauri",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tauri Benchmark — rustc release (LLVM -O3)",
        "width": 900,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
